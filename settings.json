{
  "cleanupPeriodDays": 30,
  "env": {
    "CLAUDE_TELEMETRY_OPTOUT": "1"
  },
  "includeCoAuthoredBy": false,
  "model": "opus",
  "skillOverrides": {
    "dataviz": "user-invocable-only",
    "artifact-design": "user-invocable-only",
    "update-config": "user-invocable-only",
    "keybindings-help": "user-invocable-only",
    "verify": "user-invocable-only",
    "code-review": "user-invocable-only",
    "simplify": "user-invocable-only",
    "fewer-permission-prompts": "user-invocable-only",
    "loop": "user-invocable-only",
    "schedule": "user-invocable-only",
    "claude-api": "user-invocable-only",
    "run": "user-invocable-only",
    "init": "user-invocable-only",
    "security-review": "user-invocable-only"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/session-start.js",
            "statusMessage": "Chargement du contexte de session..."
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/tools/hooks-healthcheck.sh --static",
            "statusMessage": "Controle des hooks declares...",
            "async": true
          },
          {
            "type": "command",
            "command": "node ~/.claude/tools/transcript-metrics.js --archive",
            "statusMessage": "Archivage des transcripts...",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pre-edit-write.sh",
            "statusMessage": "Verif never-assume (Read prealable)..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pre-disk-sideeffect.sh",
            "statusMessage": "Verif effet de bord disque..."
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell|Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/pre-guard-outward.js",
            "statusMessage": "Garde push/PR + mode stop..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/post-write.sh",
            "statusMessage": "Mise a jour .gitignore si necessaire...",
            "async": true
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/post-bash-silent-fail.js",
            "statusMessage": "Detection succes silencieux...",
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/post-fail-vault.js",
            "statusMessage": "Recherche vault sur cet echec..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ~/.claude/hooks/user-prompt-submit.js",
            "statusMessage": "Rappels never-assume..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/stop-verify.sh",
            "statusMessage": "Verif never-assume (post-livraison)..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/stop-narrative.sh",
            "statusMessage": "Lint narratif (incoherences introduites)..."
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/stop-vault-sync.sh",
            "statusMessage": "Sync vault Obsidian...",
            "async": true
          },
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/stop-capture-reminder.sh",
            "async": true
          }
        ]
      }
    ]
  },
  "autoUpdatesChannel": "latest",
  "switchModelsOnFlag": false,
  "autoMode": {
    "environment": [
      "### Org-wide",
      "**Organization**: None configured",
      "**Cloud provider(s)**: None configured",
      "**Repository visibility**: assume private unless the remote host and repo name indicate otherwise, or a visibility check in the transcript shows public (this repo has no remotes configured, so visibility cannot be determined)",
      "**Internal sharing / snippet hosting**: None configured — treat public paste/gist services as outside the trust boundary",
      "**Secrets management**: None configured",
      "**Default / protected branches**: unknown — no git remotes configured and origin/HEAD unset; branch protection not queryable",
      "**CI/CD deploy targets**: None configured",
      "**Network posture**: None configured",
      "**Host containment**: None configured — assume Claude Code runs on an ordinary developer machine with open internet",
      "**Source control**: The trusted repo (/home/jean-doux/Bureau/www) only — it currently has no configured remotes",
      "**Trusted internal domains**: None configured",
      "**Trusted cloud buckets**: None configured",
      "**Key internal services**: None configured",
      "**Internal package registry**: None configured",
      "**Sensitive data locations & audiences**: .env and .env.example files under binance_project/ and portfolios/dev_portfolio/ (backend, frontend, par_mutuel_urbain_back) — preserve exact handles; share only with audiences cleared at the [named+specifics] bar",
      "**Data retention / declassification**: None configured",
      "**Sensitive remote targets**: any namespace, host, or container whose name carries `prod` or `production` as a whole word or name segment",
      "**Protected deployment namespaces / environments**: None configured — fall back to the Sensitive remote targets heuristic",
      "**Protected IaC scopes**: IAM, RBAC, networking, quota, and node-pool resources; anything whose name or tag carries `prod` or `production` as a whole word or name segment",
      "### User-specific",
      "**Primary use of Claude Code**: software development",
      "**Trusted repo**: /home/jean-doux/Bureau/www (working directory; no git remotes currently configured)",
      "**Org-specific CLIs**: None configured"
    ]
  }
}
